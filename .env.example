# 复制为 .env 后按需填写（.env 不会被提交）

# 管理密钥（留空则不鉴权）
CHATGPT2API_AUTH_KEY=

# 代理池：注册必须走非 CN 出口，否则 OpenAI 直接 403。
# 填写后会由 chat2api 自动同步到容器内 RegiForge 的 proxy.wary 配置。
# 留空则不同步（RegiForge 保持自身 config.json 的设置）。
REGIFORGE_PROXY_API_URL=
REGIFORGE_PROXY_API_KEY=

# 注册成功账号自动导入 chat2api 账号池（单镜像内指向本服务 3077）。
REGIFORGE_EXPORT_BASE_URL=http://127.0.0.1:3077
# 导入时的管理员密钥；无 CHATGPT2API_AUTH_KEY 时可用任意非空占位
REGIFORGE_EXPORT_ADMIN_PASSWORD=

# 生图出站代理：chatgpt.com 直连被 CN 拒绝，需 socks5 非 CN 出口。
# 例：socks5://192.6.121.16:11032（支持 socks5:// 与 http://）
CHATGPT2API_PROXY=
